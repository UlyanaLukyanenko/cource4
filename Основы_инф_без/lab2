def per_dec_sist(ch):
    table = {
        'А': 192, 'Б': 193, 'В': 194, 'Г': 195, 'Д': 196, 'Е': 197, 'Ж': 198,
        'З': 199, 'И': 200, 'Й': 201, 'К': 202, 'Л': 203, 'М': 204, 'Н': 205,
        'О': 206, 'П': 207, 'Р': 208, 'С': 209, 'Т': 210, 'У': 211, 'Ф': 212,
        'Х': 213, 'Ц': 214, 'Ч': 215, 'Ш': 216, 'Щ': 217, 'Ъ': 218, 'Ы': 219,
        'Ь': 220, 'Э': 221, 'Ю': 222, 'Я': 223,
        'а': 224, 'б': 225, 'в': 226, 'г': 227, 'д': 228, 'е': 229, 'ж': 230,
        'з': 231, 'и': 232, 'й': 233, 'к': 234, 'л': 235, 'м': 236, 'н': 237,
        'о': 238, 'п': 239, 'р': 240, 'с': 241, 'т': 242, 'у': 243, 'ф': 244,
        'х': 245, 'ц': 246, 'ч': 247, 'ш': 248, 'щ': 249, 'ъ': 250, 'ы': 251,
        'ь': 252, 'э': 253, 'ю': 254, 'я': 255,
        ' ': 32,
    }
    if ch not in table:
        raise ValueError(f"Символ '{ch}' не найден в таблице кириллицы.")
    return format(table[ch], '08b')


def perev_str_dv_posled(text, length):
    result = ''
    for i in text:
        result += per_dec_sist(i)
    if len(result) < length:
        result = result.ljust(length, '0')
    else:
        result = result[:length]
    return result


def dv_to_int(str):
    return int(str, 2)


def int_to_dv(num, length=32):
    return format(num, f'0{length}b')


def rasdel_on_groups(bin_str, size=4):
    return [bin_str[i:i+size] for i in range(0, len(bin_str), size)]


def sbox_substitution(bin_str):

    groups = rasdel_on_groups(bin_str, 4)
    result = []
    for i, group in enumerate(groups):
        node = 8 - i  # группа 0 -> узел 8, группа 7 -> узел 1
        row = int(group, 2)
        value = B_podst_alg[(node, row)]
        result.append(format(value, '04b'))
    return ''.join(result)


def sdvig_left(str, col):
    x = col % len(str)
    return str[x:] + str[:x]


def xor_bin(a, b):
    return ''.join('1' if x != y else '0' for x, y in zip(a, b))



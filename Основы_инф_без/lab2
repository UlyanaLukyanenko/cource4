def per_dec_sist(ch):
    table = {
        'А': '11000000', 'Б': '11000001',
        'В': '11000010', 'Г': '11000011',
        'Д': '11000100', 'Е': '11000101',
        'Ж': '11000110', 'З': '11000111',
        'И': '11001000', 'Й': '11001001',
        'К': '11001010', 'Л': '11001011',
        'М': '11001100', 'Н': '11001101',
        'О': '11001110', 'П': '11001111',
        'Р': '11010000', 'С': '11010001',
        'Т': '11010010', 'У': '11010011',
        'Ф': '11010100', 'Х': '11010101',
        'Ц': '11010110', 'Ч': '11010111',
        'Ш': '11011000', 'Щ': '11011001',
        'Ъ': '11011010', 'Ы': '11011011',
        'Ь': '11011100', 'Э': '11011101',
        'Ю': '11011110', 'Я': '11011111',
        ' ': '00100000'
    }

    ch = ch.upper()
    return table[ch]


def perev_str_dv_posled(text):
    return ''.join(per_dec_sist(ch) for ch in text)


def rasdel_on_groups(binary_string, size=4):
    return [
        binary_string[i:i + size]
        for i in range(0, len(binary_string), size)
    ]

S_BOX = [
    [1, 13, 4, 6, 7, 5, 14, 4],
    [15, 11, 11, 12, 13, 8, 11, 10],
    [13, 4, 10, 7, 10, 1, 4, 9],
    [0, 1, 0, 1, 1, 13, 12, 2],

def slozhenie_mod_2_32(a, b):
    result = ""
    carry = 0

    for i in range(31, -1, -1):
        bit_a = int(a[i])
        bit_b = int(b[i])

        summa = bit_a + bit_b + carry

        result_bit = summa % 2
        carry = summa // 2

        result = str(result_bit) + result
    return result


def podstanovka(value):
    result = ""

    for i in range(8):
        tetrada = value[i * 4:i * 4 + 4]
        number = int(tetrada, 2)
        column = i

        new_number = S_BOX[number][column]
        new_tetrada = format(new_number, "04b")

        result += new_tetrada

    return result


def sdvig_vlevo_11(value):
    return value[11:] + value[:11]


def xor(a, b):
    result = ""

    for i in range(len(a)):
        if a[i] == b[i]:
            result += "0"
        else:
            result += "1"

    return result


def pervyi_raund(L0, R0, X0):

    print("ГОСТ 28147-89")
    print("=" * 55)
    summa = slozhenie_mod_2_32(R0, X0)

    print("\n1. Сложение R0 и X0 по модулю 2^32:")
    print("R0:    ", " ".join(rasdel_on_groups(R0)))
    print("X0:    ", " ".join(rasdel_on_groups(X0)))
    print("Сумма: ", " ".join(rasdel_on_groups(summa)))

    zamena = podstanovka(summa)

    print("\n2. После подстановки:")
    print(" ".join(rasdel_on_groups(zamena)))
    sdvig = sdvig_vlevo_11(zamena)

    print("\n3. После циклического сдвига на 11:")
    print(" ".join(rasdel_on_groups(sdvig)))
    R1 = xor(L0, sdvig)

    print("\n4. f(R0,X0)+ LO")
    print("L0:       ", " ".join(rasdel_on_groups(L0)))
    print("Результат:", " ".join(rasdel_on_groups(R1)))

    print("R1: ", " ".join(rasdel_on_groups(R1)))

    return  R1


def main():
    print("ГОСТ 28147-89 ")

    fio = input("Введите ФИО: ").strip().upper()

    full_text = fio + " КРИПТОГРАФИЯ"
    block = full_text[:8]
    key = full_text[8:12]

    if len(block) != 8 or len(key) != 4:
        print("Ошибка: недостаточно символов.")
        return

    print("\nИсходная строка:", full_text)
    print("Первый блок:", block)
    print("Первый подключ:", key)
    text_bin = perev_str_dv_posled(block)
    key_bin = perev_str_dv_posled(key)

    print("\nДвоичное представление исходного блока:")
    for ch in block:
        print(f"{ch} -> {per_dec_sist(ch)}")

    print("\nДвоичное представление первого подключа:")
    for ch in key:
        print(f"{ch} -> {per_dec_sist(ch)}")

    L0 = text_bin[:32]
    R0 = text_bin[32:64]

    X0 = key_bin

    print("\nL0 (первые 32 бита):")
    print(" ".join(rasdel_on_groups(L0)))

    print("\nR0 (следующие 32 бита):")
    print(" ".join(rasdel_on_groups(R0)))

    print("\nX0 (32 бита первого подключа):")
    print(" ".join(rasdel_on_groups(X0)))

    pervyi_raund(L0, R0, X0)

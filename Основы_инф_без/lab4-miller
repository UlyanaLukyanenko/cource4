import random

SMALL_PRIMES = [2, 3, 5, 7, 11, 13, 17, 19]


TEST_COUNT = 5

BITS = 21

rng = random.SystemRandom()


def generate_number():
    """Генерирует случайное нечётное 21-битное число."""
    p = rng.getrandbits(BITS)

    p = p | (1 << (BITS - 1)) | 1

    return p


def small_prime_check(p):
    """Проверка делимости на первые простые числа."""

    print("\nПРЕДВАРИТЕЛЬНАЯ ПРОВЕРКА")
    print("-" * 60)

    for k in SMALL_PRIMES:
        remainder = p % k

        print(f"{p} mod {k} = {remainder}", end="")

        if remainder == 0:
            print("  --> Число делится на", k)
            return False

        print("  --> Не делится")

    print("Результат: число прошло предварительную проверку.")
    return True


def miller_rabin(p, test_number):
    """Одна проверка числа тестом Рабина — Миллера."""

    print("\n" + "=" * 60)
    print(f"ТЕСТ РАБИНА — МИЛЛЕРА № {test_number}")
    print("=" * 60)

    # Шаг 1. Представляем p - 1 в виде 2^b * m

    n = p - 1
    m = n
    b = 0

    while m % 2 == 0:
        m //= 2
        b += 1

    print(f"\np = {p}")
    print(f"p - 1 = {n}")
    print(f"Разложение: p - 1 = 2^{b} * {m}")
    print(f"b = {b}")
    print(f"m = {m}")

    # Шаг 2. Выбираем случайное основание a

    a = rng.randint(2, p - 2)

    print(f"\nСлучайное основание a = {a}")

    # Шаг 3. Вычисляем z0 = a^m mod p

    z = pow(a, m, p)

    print("\nВычисление z0:")
    print(f"z0 = {a}^{m} mod {p} = {z}")

    # Шаг 4. Проверяем первое условие

    if z == 1:
        print("\nz0 = 1")
        print("Условие выполнено.")
        print("Число прошло данный тест.")
        return True

    if z == p - 1:
        print(f"\nz0 = p - 1 = {p - 1}")
        print("Условие выполнено.")
        print("Число прошло данный тест.")
        return True

    # Шаг 5. Последовательно возводим z в квадрат
    # z_j = z_(j-1)^2 mod p

    print("\nПоследовательное возведение в квадрат:")

    for j in range(1, b):

        z = pow(z, 2, p)

        print(f"z{j} = z{j-1}^2 mod p = {z}")

        # Если получили p - 1, тест пройден

        if z == p - 1:
            print(f"\nz{j} = p - 1 = {p - 1}")
            print("Число прошло данный тест.")
            return True

        # Если получили 1 раньше p - 1, число составное

        if z == 1:
            print("\nПолучено z = 1 до получения p - 1.")
            print("Число составное.")
            return False

    # Если p - 1 не получено, число составное

    print("\nУсловие z = p - 1 не выполнено.")
    print("Число составное.")
    return False


def main():

    print("=" * 65)
    print("          ОПРЕДЕЛЕНИЕ ПРОСТОГО ЧИСЛА")
    print("              ТЕСТ РАБИНА — МИЛЛЕРА")
    print("=" * 65)

    # --------------------------------------------------------
    # ЭТАП 1. Генерация случайного числа
    # --------------------------------------------------------

    print("\nЭТАП 1. ГЕНЕРАЦИЯ 21-БИТНОГО ЧИСЛА")

    p = generate_number()

    print(f"Двоичное число: {bin(p)[2:]}")
    print(f"Десятичное число: {p}")
    print(f"Количество бит: {p.bit_length()}")
    print("Старший бит = 1")
    print("Младший бит = 1 (число нечётное)")

    # --------------------------------------------------------
    # ЭТАП 2. Предварительная проверка
    # --------------------------------------------------------

    print("\nЭТАП 2. ПРОВЕРКА НА МАЛЫЕ ПРОСТЫЕ ДЕЛИТЕЛИ")

    while True:

        print("\nПроверяем кандидата p =", p)

        if small_prime_check(p):
            break

        print("\nКандидат не прошёл проверку.")
        print("Увеличиваем p на 2.")

        p += 2

        # Сохраняем разрядность 21 бит
        if p >= 2 ** BITS:
            print("\nДостигнута верхняя граница 21-битных чисел.")
            print("Генерируем новое случайное число.")
            p = generate_number()

    print("\n" + "=" * 65)
    print("КАНДИДАТ ПРОШЁЛ ПРЕДВАРИТЕЛЬНУЮ ПРОВЕРКУ")
    print("=" * 65)

    print(f"Итоговое число p = {p}")
    print(f"Двоичная запись: {bin(p)[2:]}")

    # --------------------------------------------------------
    # ЭТАП 3. Пять проверок Рабина — Миллера
    # --------------------------------------------------------

    print("\nЭТАП 3. ПЯТЬ ПРОВЕРОК РАБИНА — МИЛЛЕРА")

    passed_tests = 0

    for i in range(1, TEST_COUNT + 1):

        result = miller_rabin(p, i)

        if result:
            passed_tests += 1
            print(f"\nРезультат теста № {i}: ПРОЙДЕН")

        else:
            print(f"\nРезультат теста № {i}: НЕ ПРОЙДЕН")
            print("\nИТОГ: ЧИСЛО СОСТАВНОЕ.")

            # Переходим к следующему нечётному кандидату
            print("\nУвеличиваем p на 2 и ищем нового кандидата.")
            p += 2

            # Повторяем поиск с предварительной проверкой
            while True:

                print("\nПроверяем кандидата p =", p)

                if p >= 2 ** BITS:
                    p = generate_number()
                    continue

                if small_prime_check(p):
                    break

                p += 2

            # Начинаем пять проверок для нового кандидата
            print("\nНайден новый кандидат:", p)

            passed_tests = 0

            # Запускаем проверку нового кандидата
            for j in range(1, TEST_COUNT + 1):

                if miller_rabin(p, j):
                    passed_tests += 1
                    print(f"\nРезультат теста № {j}: ПРОЙДЕН")
                else:
                    print(f"\nРезультат теста № {j}: НЕ ПРОЙДЕН")
                    break

            # Если все тесты нового кандидата не пройдены,
            # повторяем поиск нового числа
            while passed_tests != TEST_COUNT:

                print("\nКандидат не прошёл все пять тестов.")
                p += 2

                while True:

                    if p >= 2 ** BITS:
                        p = generate_number()
                        continue

                    if small_prime_check(p):
                        break

                    p += 2

                print("\nНовый кандидат:", p)

                passed_tests = 0

                for j in range(1, TEST_COUNT + 1):

                    if miller_rabin(p, j):
                        passed_tests += 1
                        print(f"\nРезультат теста № {j}: ПРОЙДЕН")
                    else:
                        print(f"\nРезультат теста № {j}: НЕ ПРОЙДЕН")
                        break

            break

    # --------------------------------------------------------
    # ЭТАП 4. Итог и вероятность
    # --------------------------------------------------------

    if passed_tests == TEST_COUNT:

        probability_composite = (1 / 4) ** TEST_COUNT
        probability_prime = 1 - probability_composite

        print("\n" + "=" * 65)
        print("                  ИТОГОВЫЙ РЕЗУЛЬТАТ")
        print("=" * 65)

        print(f"\nНайденное число p = {p}")
        print(f"Двоичная запись: {bin(p)[2:]}")

        print(f"\nКоличество пройденных тестов: {passed_tests} из {TEST_COUNT}")

        print("\nЧИСЛО ВЕРОЯТНО ПРОСТОЕ!")

        print("\nРасчёт вероятности:")

        print(f"P(составное) <= (1/4)^{TEST_COUNT}")

        print(f"P(составное) <= {probability_composite:.10f}")

        print(f"P(составное) <= {probability_composite * 100:.6f}%")

        print(f"\nP(простое) >= {probability_prime:.10f}")

        print(f"P(простое) >= {probability_prime * 100:.6f}%")

        print("\nВывод:")
        print(
            "Число прошло пять проверок Рабина — Миллера. "
            "Вероятность того, что оно составное, "
            "не превышает 0.1%."
        )

    print("\n" + "=" * 65)
    print("                 ПРОГРАММА ЗАВЕРШЕНА")
    print("=" * 65)


if __name__ == "__main__":
    main()
